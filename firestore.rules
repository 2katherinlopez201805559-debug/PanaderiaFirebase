rules_version = '2';
// Panadería San Carlos: SOLO el backend Java (Firebase Admin SDK) entra a la base.
// El Admin SDK no pasa por estas reglas; cualquier otro acceso directo se bloquea.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
